    {
      "name": "daily_request_volume",
      "displayName": "Daily Request Volume",
      "queryLines": [
        "SELECT\n",
        "  DATE(eu.request_time) AS request_date,\n",
        "  COUNT(*) AS requests\n",
        "FROM\n",
        "  system.serving.endpoint_usage eu\n",
        "WHERE\n",
        "  eu.request_time >= :date_range.min\n",
        "  AND eu.request_time <= :date_range.max\n",
        "GROUP BY\n",
        "  1\n",
        "ORDER BY\n",
        "  1"
      ],
      "parameters": [
        {
          "displayName": "Date Range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "daily_cost_trend",
      "displayName": "Daily Cost Trend by Endpoint",
      "queryLines": [
        "WITH top_endpoints AS (\n",
        "  SELECT\n",
        "    se.endpoint_name\n",
        "  FROM\n",
        "    system.billing.usage u\n",
        "      INNER JOIN system.serving.served_entities se\n",
        "        ON u.usage_metadata.endpoint_id = se.endpoint_id\n",
        "  WHERE\n",
        "    (\n",
        "      u.sku_name LIKE '%SERVING%'\n",
        "      OR u.sku_name LIKE '%MODEL_INFERENCE%'\n",
        "    )\n",
        "    AND u.usage_date >= :date_range.min\n",
        "    AND u.usage_date <= :date_range.max\n",
        "  GROUP BY\n",
        "    se.endpoint_name\n",
        "  ORDER BY\n",
        "    SUM(u.usage_quantity) DESC\n",
        "  LIMIT 5\n",
        ")\n",
        "SELECT\n",
        "  u.usage_date,\n",
        "  se.endpoint_name,\n",
        "  ROUND(\n",
        "    SUM(u.usage_quantity * COALESCE(lp.pricing.effective_list.default, lp.pricing.default)),\n",
        "    2\n",
        "  ) AS estimated_cost_usd\n",
        "FROM\n",
        "  system.billing.usage u\n",
        "    LEFT JOIN system.billing.list_prices lp\n",
        "      ON u.sku_name = lp.sku_name\n",
        "      AND u.cloud = lp.cloud\n",
        "      AND u.usage_start_time >= lp.price_start_time\n",
        "      AND (\n",
        "        lp.price_end_time IS NULL\n",
        "        OR u.usage_start_time < lp.price_end_time\n",
        "      )\n",
        "    INNER JOIN system.serving.served_entities se\n",
        "      ON u.usage_metadata.endpoint_id = se.endpoint_id\n",
        "WHERE\n",
        "  (\n",
        "    u.sku_name LIKE '%SERVING%'\n",
        "    OR u.sku_name LIKE '%MODEL_INFERENCE%'\n",
        "  )\n",
        "  AND u.usage_date >= :date_range.min\n",
        "  AND u.usage_date <= :date_range.max\n",
        "  AND se.endpoint_name IN (\n",
        "    SELECT\n",
        "      endpoint_name\n",
        "    FROM\n",
        "      top_endpoints\n",
        "  )\n",
        "GROUP BY\n",
        "  u.usage_date,\n",
        "  se.endpoint_name\n",
        "ORDER BY\n",
        "  u.usage_date"
      ],
      "parameters": [
        {
          "displayName": "Date Range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "total_tokens_30d",
      "displayName": "Total Tokens",
      "queryLines": [
        "SELECT\n",
        "  SUM(input_token_count + output_token_count) AS total_tokens\n",
        "FROM\n",
        "  system.serving.endpoint_usage\n",
        "WHERE\n",
        "  request_time >= :date_range.min\n",
        "  AND request_time <= :date_range.max"
      ],
      "parameters": [
        {
          "displayName": "Date Range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "error_rate_by_endpoint",
      "displayName": "Error Rate by Endpoint",
      "queryLines": [
        "SELECT\n",
        "  se.endpoint_name,\n",
        "  ROUND(\n",
        "    100.0\n",
        "      * SUM(\n",
        "        CASE\n",
        "          WHEN eu.status_code >= 400 THEN 1\n",
        "          ELSE 0\n",
        "        END\n",
        "      )\n",
        "      / COUNT(*),\n",
        "    2\n",
        "  ) AS error_pct\n",
        "FROM\n",
        "  system.serving.endpoint_usage eu\n",
        "    JOIN system.serving.served_entities se\n",
        "      ON eu.served_entity_id = se.served_entity_id\n",
        "WHERE\n",
        "  eu.request_time >= :date_range.min\n",
        "  AND eu.request_time <= :date_range.max\n",
        "GROUP BY\n",
        "  se.endpoint_name\n",
        "HAVING\n",
        "  COUNT(*) > 100\n",
        "ORDER BY\n",
        "  error_pct DESC\n",
        "LIMIT 10"
      ],
      "parameters": [
        {
          "displayName": "Date Range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "usage_by_requester",
      "displayName": "Usage by Requester",
      "queryLines": [
        "SELECT\n",
        "  eu.requester,\n",
        "  COUNT(*) AS total_requests,\n",
        "  SUM(eu.input_token_count + eu.output_token_count) AS total_tokens\n",
        "FROM\n",
        "  system.serving.endpoint_usage eu\n",
        "WHERE\n",
        "  eu.request_time >= :date_range.min\n",
        "  AND eu.request_time <= :date_range.max\n",
        "GROUP BY\n",
        "  eu.requester\n",
        "ORDER BY\n",
        "  total_tokens DESC\n",
        "LIMIT 10"
      ],
      "parameters": [
        {
          "displayName": "Date Range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "hourly_pattern",
      "displayName": "Hourly Request Pattern",
      "queryLines": [
        "SELECT\n",
        "  HOUR(eu.request_time) AS hour_of_day,\n",
        "  COUNT(*) AS total_requests\n",
        "FROM\n",
        "  system.serving.endpoint_usage eu\n",
        "WHERE\n",
        "  eu.request_time >= :date_range.min\n",
        "  AND eu.request_time <= :date_range.max\n",
        "GROUP BY\n",
        "  1\n",
        "ORDER BY\n",
        "  1"
      ],
      "parameters": [
        {
          "displayName": "Date Range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    }
