    {
      "name": "ds_users",
      "displayName": "Per user",
      "queryLines": [
        "WITH gh AS (   SELECT warehouse_id, hour_ts, SUM(genie_ms) AS genie_ms, SUM(genie_q) AS genie_q   FROM main.mki_genie_cost.space_user_hourly   WHERE genie_space_id = :genie_space AND to_date(hour_ts) BETWEEN :date_range.min AND :date_range.max   GROUP BY 1,2 ), gw AS (SELECT DISTINCT warehouse_id FROM gh), wh AS (   SELECT warehouse_id, hour_ts, total_ms, dbus FROM main.mki_genie_cost.wh_hourly   WHERE warehouse_id IN (SELECT warehouse_id FROM gw)     AND to_date(hour_ts) BETWEEN :date_range.min AND :date_range.max ), p AS (SELECT cast(:dbu_price AS DOUBLE) AS price)  , uh AS (   SELECT warehouse_id, hour_ts, user_email, SUM(genie_ms) u_ms, SUM(genie_q) q   FROM main.mki_genie_cost.space_user_hourly   WHERE genie_space_id=:genie_space AND to_date(hour_ts) BETWEEN :date_range.min AND :date_range.max   GROUP BY 1,2,3 ), whtot AS (SELECT SUM(dbus) dbus FROM wh) SELECT COALESCE(uh.user_email,'(unknown)') user_email, SUM(uh.q) genie_queries,        ROUND(SUM(uh.u_ms)/1000.0,1) active_sec,        ROUND(SUM(wh.dbus*uh.u_ms/wh.total_ms)*MAX(p.price),4) est_cost_usd,        ROUND(100.0*SUM(wh.dbus*uh.u_ms/wh.total_ms)/NULLIF(MAX(whtot.dbus),0),4) pct_of_wh_cost FROM uh JOIN wh USING(warehouse_id,hour_ts) CROSS JOIN p CROSS JOIN whtot WHERE wh.total_ms>0 GROUP BY 1 ORDER BY est_cost_usd DESC "
      ],
      "parameters": [
