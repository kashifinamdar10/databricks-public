                {
                  "value": "0.393"
                }
              ]
            }
          }
        },
        {
          "displayName": "Date range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
