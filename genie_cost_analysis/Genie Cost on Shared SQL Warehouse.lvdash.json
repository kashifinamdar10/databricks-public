    {
      "name": "ds_daily",
      "displayName": "Daily",
      "queryLines": [
        "WITH gh AS (   SELECT warehouse_id, hour_ts, SUM(genie_ms) AS genie_ms, SUM(genie_q) AS genie_q   FROM main.mki_genie_cost.space_user_hourly   WHERE genie_space_id = :genie_space AND to_date(hour_ts) BETWEEN :date_range.min AND :date_range.max   GROUP BY 1,2 ), gw AS (SELECT DISTINCT warehouse_id FROM gh), wh AS (   SELECT warehouse_id, hour_ts, total_ms, dbus FROM main.mki_genie_cost.wh_hourly   WHERE warehouse_id IN (SELECT warehouse_id FROM gw)     AND to_date(hour_ts) BETWEEN :date_range.min AND :date_range.max ), p AS (SELECT cast(:dbu_price AS DOUBLE) AS price)  , whd AS (SELECT to_date(hour_ts) d, SUM(dbus) dbus FROM wh GROUP BY 1), gd AS (SELECT to_date(gh.hour_ts) d, SUM(wh.dbus*gh.genie_ms/wh.total_ms) genie_dbus, SUM(gh.genie_q) q        FROM gh JOIN wh USING(warehouse_id,hour_ts) WHERE wh.total_ms>0 GROUP BY 1) SELECT whd.d usage_date, ROUND(whd.dbus*p.price,2) warehouse_cost_usd,        ROUND(COALESCE(gd.genie_dbus,0)*p.price,4) genie_cost_usd, COALESCE(gd.q,0) genie_queries FROM whd LEFT JOIN gd USING(d) CROSS JOIN p ORDER BY usage_date "
      ],
      "parameters": [
        {
          "displayName": "Genie space",
          "keyword": "genie_space",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
