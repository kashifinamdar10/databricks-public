{
  "datasets": [
    {
      "name": "ds_spaces",
      "displayName": "Spaces",
      "queryLines": [
        "SELECT genie_space_id, SUM(genie_q) AS queries FROM main.mki_genie_cost.space_user_hourly GROUP BY 1 ORDER BY queries DESC "
      ]
    },
    {
      "name": "ds_summary",
      "displayName": "Summary",
      "queryLines": [
        "WITH gh AS (   SELECT warehouse_id, hour_ts, SUM(genie_ms) AS genie_ms, SUM(genie_q) AS genie_q   FROM main.mki_genie_cost.space_user_hourly   WHERE genie_space_id = :genie_space AND to_date(hour_ts) BETWEEN :date_range.min AND :date_range.max   GROUP BY 1,2 ), gw AS (SELECT DISTINCT warehouse_id FROM gh), wh AS (   SELECT warehouse_id, hour_ts, total_ms, dbus FROM main.mki_genie_cost.wh_hourly   WHERE warehouse_id IN (SELECT warehouse_id FROM gw)     AND to_date(hour_ts) BETWEEN :date_range.min AND :date_range.max ), p AS (SELECT cast(:dbu_price AS DOUBLE) AS price)  , alloc AS (   SELECT SUM(wh.dbus*gh.genie_ms/wh.total_ms) AS genie_dbus, SUM(gh.genie_ms) AS genie_ms, SUM(gh.genie_q) AS genie_q   FROM gh JOIN wh USING(warehouse_id,hour_ts) WHERE wh.total_ms>0 ), whtot AS (   SELECT COUNT(DISTINCT hour_ts) running_hours, SUM(dbus) dbus, AVG(dbus) avg_dbu, MIN(dbus) min_dbu,          percentile(dbus,0.5) med_dbu, percentile(dbus,0.9) p90_dbu, MAX(dbus) max_dbu, SUM(total_ms) all_ms   FROM wh ), nu AS (SELECT COUNT(DISTINCT user_email) n_users FROM main.mki_genie_cost.space_user_hourly        WHERE genie_space_id=:genie_space AND to_date(hour_ts) BETWEEN :date_range.min AND :date_range.max), cfg AS (SELECT * FROM main.mki_genie_cost.wh_config WHERE warehouse_id IN (SELECT warehouse_id FROM gw)) SELECT   MAX(cfg.warehouse_name) warehouse_name, MAX(cfg.warehouse_size) warehouse_size,   MAX(cfg.min_clusters) min_clusters, MAX(cfg.max_clusters) max_clusters, MAX(cfg.auto_stop_minutes) auto_stop_minutes,   ROUND(MAX(whtot.dbus)*MAX(p.price),2) wh_cost_usd, ROUND(MAX(whtot.running_hours),0) running_hours,   ROUND(MAX(whtot.avg_dbu)*MAX(p.price),2) avg_cost_hr, ROUND(MAX(whtot.min_dbu)*MAX(p.price),2) min_cost_hr,   ROUND(MAX(whtot.med_dbu)*MAX(p.price),2) median_cost_hr, ROUND(MAX(whtot.p90_dbu)*MAX(p.price),2) p90_cost_hr,   ROUND(MAX(whtot.max_dbu)*MAX(p.price),2) max_cost_hr,   ROUND(MAX(alloc.genie_dbus)*MAX(p.price),2) genie_cost_usd, ROUND(MAX(alloc.genie_dbus),2) genie_dbus,   MAX(nu.n_users) n_users, MAX(alloc.genie_q) genie_queries,   ROUND(100.0*MAX(alloc.genie_dbus)/NULLIF(MAX(whtot.dbus),0),3) genie_pct_of_cost,   ROUND(100.0*MAX(alloc.genie_ms)/NULLIF(MAX(whtot.all_ms),0),3) genie_pct_of_activetime FROM alloc CROSS JOIN whtot CROSS JOIN nu CROSS JOIN p LEFT JOIN cfg ON 1=1 "
      ],
      "parameters": [
        {
          "displayName": "Genie space",
          "keyword": "genie_space",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "01f164d0ba841bbbaf8b9c3ef43503cf"
                }
              ]
            }
          }
        },
        {
          "displayName": "DBU price ($/DBU)",
          "keyword": "dbu_price",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "0.393"
                }
              ]
            }
          }
        },
        {
          "displayName": "Date range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "ds_split",
      "displayName": "Genie vs Rest",
      "queryLines": [
        "WITH gh AS (   SELECT warehouse_id, hour_ts, SUM(genie_ms) AS genie_ms, SUM(genie_q) AS genie_q   FROM main.mki_genie_cost.space_user_hourly   WHERE genie_space_id = :genie_space AND to_date(hour_ts) BETWEEN :date_range.min AND :date_range.max   GROUP BY 1,2 ), gw AS (SELECT DISTINCT warehouse_id FROM gh), wh AS (   SELECT warehouse_id, hour_ts, total_ms, dbus FROM main.mki_genie_cost.wh_hourly   WHERE warehouse_id IN (SELECT warehouse_id FROM gw)     AND to_date(hour_ts) BETWEEN :date_range.min AND :date_range.max ), p AS (SELECT cast(:dbu_price AS DOUBLE) AS price)  , alloc AS (SELECT SUM(wh.dbus*gh.genie_ms/wh.total_ms) genie_dbus, SUM(gh.genie_ms) genie_ms             FROM gh JOIN wh USING(warehouse_id,hour_ts) WHERE wh.total_ms>0), whtot AS (SELECT SUM(dbus) dbus, SUM(total_ms) all_ms FROM wh) SELECT 'Genie space' segment, ROUND(alloc.genie_ms/1000.0,1) active_sec, ROUND(alloc.genie_dbus*p.price,2) est_cost_usd FROM alloc CROSS JOIN whtot CROSS JOIN p UNION ALL SELECT 'Other queries (shared)', ROUND((whtot.all_ms-alloc.genie_ms)/1000.0,1), ROUND((whtot.dbus-alloc.genie_dbus)*p.price,2) FROM alloc CROSS JOIN whtot CROSS JOIN p "
      ],
      "parameters": [
        {
          "displayName": "Genie space",
          "keyword": "genie_space",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
