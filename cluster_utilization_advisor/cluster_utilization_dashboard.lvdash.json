        {
          "widget": {
            "name": "chart_autoscale_status",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_cluster_assessment",
                  "fields": [
                    {
                      "name": "autoscale_status",
                      "expression": "CASE WHEN NOT `autoscale_enabled` THEN 'No autoscale (fixed)' WHEN `p95_active_workers` >= `max_autoscale_workers` THEN 'Pinned at ceiling' WHEN `p95_active_workers` <= `min_autoscale_workers` AND `min_autoscale_workers` < `max_autoscale_workers` THEN 'Stuck at floor' ELSE 'Scaling normally' END"
                    },
                    {
                      "name": "cluster_count",
                      "expression": "COUNT(`cluster_id`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "autoscale_status",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Autoscale Status"
                },
                "y": {
                  "fieldName": "cluster_count",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Clusters"
                }
              },
              "frame": {
                "title": "Autoscaling Effectiveness",
                "showTitle": true
