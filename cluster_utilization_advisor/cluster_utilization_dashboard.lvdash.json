        {
          "widget": {
            "name": "chart_term_band",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_cluster_assessment",
                  "fields": [
                    {
                      "name": "termination_band",
                      "expression": "CASE WHEN `auto_termination_minutes` IS NULL THEN 'DISABLED (risky)' WHEN `auto_termination_minutes` <= 30 THEN '<= 30 min (good)' WHEN `auto_termination_minutes` <= 60 THEN '31-60 min (ok)' WHEN `auto_termination_minutes` <= 120 THEN '61-120 min (loose)' ELSE '> 120 min (too loose)' END"
                    },
                    {
                      "name": "cluster_count",
                      "expression": "COUNT(`cluster_id`)"
                    },
                    {
                      "name": "avg_idle_percent",
                      "expression": "ROUND(AVG(`idle_percent`),2)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
