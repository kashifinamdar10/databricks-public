{
  "datasets": [
    {
      "name": "per_cluster",
      "displayName": "Per-cluster utilization",
      "queryLines": [
        "SELECT * FROM mohdkashif_inamdar.cluster_utilization_advisor.per_cluster_utilization"
      ]
    },
    {
      "name": "hourly",
      "displayName": "Hourly utilization (drill-down)",
      "queryLines": [
        "SELECT * FROM mohdkashif_inamdar.cluster_utilization_advisor.hourly_cluster_utilization"
      ]
    },
    {
      "name": "per_job",
      "displayName": "Per-job utilization",
      "queryLines": [
        "SELECT * FROM mohdkashif_inamdar.cluster_utilization_advisor.per_job_utilization"
      ]
    },
    {
      "name": "kpi_under",
      "displayName": "Under-utilized",
      "queryLines": [
        "SELECT COUNT(*) AS n FROM mohdkashif_inamdar.cluster_utilization_advisor.per_cluster_utilization WHERE utilization_verdict = 'UNDER_UTILIZED'"
      ]
    },
    {
      "name": "kpi_over",
      "displayName": "Over-utilized",
      "queryLines": [
        "SELECT COUNT(*) AS n FROM mohdkashif_inamdar.cluster_utilization_advisor.per_cluster_utilization WHERE utilization_verdict = 'OVER_UTILIZED'"
      ]
    },
    {
      "name": "kpi_right",
      "displayName": "Right-sized",
      "queryLines": [
        "SELECT COUNT(*) AS n FROM mohdkashif_inamdar.cluster_utilization_advisor.per_cluster_utilization WHERE utilization_verdict = 'RIGHT_SIZED'"
      ]
    },
    {
      "name": "kpi_waste",
      "displayName": "Estimated waste ($)",
      "queryLines": [
        "SELECT ROUND(SUM(estimated_waste_usd), 2) AS n FROM mohdkashif_inamdar.cluster_utilization_advisor.per_cluster_utilization"
      ]
    },
    {
      "name": "kpi_cost",
      "displayName": "Total list cost ($)",
      "queryLines": [
        "SELECT ROUND(SUM(list_cost_usd), 2) AS n FROM mohdkashif_inamdar.cluster_utilization_advisor.per_cluster_utilization"
      ]
    },
    {
      "name": "top_underutilized",
      "displayName": "Top under-utilized clusters by waste",
      "queryLines": [
        "SELECT cluster_name, cluster_source, worker_node_type, worker_count,\n",
        "              avg_cpu_busy_pct, p95_cpu_busy_pct, avg_mem_used_pct, p95_mem_used_pct,\n",
        "              list_cost_usd, estimated_waste_usd, recommendation, cluster_id\n",
        "       FROM mohdkashif_inamdar.cluster_utilization_advisor.per_cluster_utilization\n",
        "       WHERE utilization_verdict = 'UNDER_UTILIZED'\n",
        "       ORDER BY estimated_waste_usd DESC\n",
        "       LIMIT 25"
      ]
    },
    {
      "name": "top_overutilized",
      "displayName": "Over-utilized clusters",
      "queryLines": [
        "SELECT cluster_name, cluster_source, worker_node_type, worker_count,\n",
        "              p95_cpu_busy_pct, p95_mem_used_pct, max_mem_swap_pct,\n",
        "              list_cost_usd, recommendation, cluster_id\n",
        "       FROM mohdkashif_inamdar.cluster_utilization_advisor.per_cluster_utilization\n",
        "       WHERE utilization_verdict = 'OVER_UTILIZED'\n",
        "       ORDER BY list_cost_usd DESC\n",
        "       LIMIT 25"
      ]
    },
    {
      "name": "rightsizing",
      "displayName": "Right-sizing details",
      "queryLines": [
        "SELECT * FROM mohdkashif_inamdar.cluster_utilization_advisor.cluster_rightsizing_details WHERE utilization_verdict IN ('UNDER_UTILIZED', 'OVER_UTILIZED', 'REVIEW') ORDER BY COALESCE(estimated_waste_usd, 0) DESC, list_cost_usd DESC LIMIT 500"
      ],
      "columns": [
        {
          "displayName": "Action Category",
          "expression": "CASE WHEN `recommended_action` LIKE '%Mostly idle%' THEN 'Consider Serverless / Shut down' WHEN `recommended_action` LIKE '%Memory-bound%' THEN 'Memory optimization needed' WHEN `recommended_action` LIKE '%CPU-bound%' THEN 'CPU optimization needed' WHEN `recommended_action` LIKE '%Reduce max_autoscale_workers%' THEN 'Reduce autoscale workers' WHEN `recommended_action` LIKE '%reduce max workers%' THEN 'Reduce max workers' WHEN `recommended_action` LIKE '%Reduce worker count%' THEN 'Reduce worker count' ELSE 'Other' END"
        }
      ]
    },
    {
      "name": "jobs_top",
      "displayName": "Top jobs by cost",
      "queryLines": [
        "SELECT job_name, job_id, cluster_id, dbus, list_cost_usd,\n",
        "              utilization_verdict, avg_cpu_busy_pct, p95_cpu_busy_pct,\n",
        "              avg_mem_used_pct, recommendation\n",
        "       FROM mohdkashif_inamdar.cluster_utilization_advisor.per_job_utilization\n",
        "       ORDER BY list_cost_usd DESC\n",
        "       LIMIT 100"
      ]
    }
  ],
