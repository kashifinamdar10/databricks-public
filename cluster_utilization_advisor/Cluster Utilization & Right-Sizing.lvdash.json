        {
          "widget": {
            "name": "kpi_over",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_cluster_assessment",
                  "fields": [
                    {
                      "name": "count(cluster_id)",
                      "expression": "COUNT(`cluster_id`)"
                    }
                  ],
